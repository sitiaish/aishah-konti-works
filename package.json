{
  "name": "aishah-konti-works",
  "private": true,
  "description": "Tools for tidying the code only. The site itself needs nothing installed.",
  "type": "module",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . && stylelint \"css/**/*.css\"",
    "check": "npm run format:check && npm run lint"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "stylelint": "18.0.0",
    "stylelint-config-recommended": "19.0.0"
  }
}
